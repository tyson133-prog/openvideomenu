{
  "name": "@openvideomenu/asset-server",
  "version": "0.1.0",
  "description": "Proof-of-concept LAN server that hands menu manifests and menu art to TV apps. Read-only; serves only files a manifest names as menu art; never media.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "openvideomenu-asset-server": "dist/main.js"
  },
  "files": ["dist"],
  "dependencies": {
    "@openvideomenu/core": "0.1.0",
    "bonjour-service": "^1.3.0"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js"
  }
}

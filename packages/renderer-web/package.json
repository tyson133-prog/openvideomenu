{
  "name": "@openvideomenu/renderer-web",
  "version": "1.0.0-preview.1",
  "description": "Reference 10-foot web renderer for Open Video Menu menus. Plugs into any host through playback, input and media-resolver adapters.",
  "license": "Apache-2.0",
  "homepage": "https://openvideomenu.org/",
  "repository": { "type": "git", "url": "git+https://github.com/tyson133-prog/openvideomenu.git", "directory": "packages/renderer-web" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundle": "./dist/openvideomenu-player.js",
    "./host.html": "./dist/host.html"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@openvideomenu/core": "1.0.0-preview.1"
  },
  "scripts": {
    "build": "tsc -b && esbuild src/bundle.ts --bundle --format=iife --global-name=OpenVideoMenuPlayer --target=es2020 --outfile=dist/openvideomenu-player.js --sourcemap && node -e \"require('fs').copyFileSync('src/host.html','dist/host.html')\"",
    "prepack": "node ../../scripts/copy-legal.mjs"
  }
}

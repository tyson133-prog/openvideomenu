{
  "name": "openvideomenu-monorepo",
  "private": true,
  "description": "Open Video Menu: an open, royalty-free format for menus over existing media files.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.2" },
  "workspaces": [
    "packages/core",
    "packages/renderer-web",
    "packages/asset-server",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build -w @openvideomenu/core && npm run build -w @openvideomenu/renderer-web && npm run build -w @openvideomenu/asset-server && npm run build -w @openvideomenu/cli",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/renderer-web packages/asset-server packages/cli",
    "preview:sintel": "node packages/cli/dist/main.js preview examples/sintel",
    "preview:dvd": "node packages/cli/dist/main.js preview examples/dvd-shaped",
    "site:spec": "node site/tools/build-spec.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.0",
    "marked": "^15.0.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

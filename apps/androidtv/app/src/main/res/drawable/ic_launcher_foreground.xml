<?xml version="1.0" encoding="utf-8"?>
<!--
  A disc with a play mark, in the banner's gold. Everything sits inside the adaptive-icon safe zone
  (a 66dp circle in the middle of 108dp), so launchers that crop to circles or squircles never clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- disc rim -->
    <path android:strokeColor="#FFFFD27A" android:strokeWidth="3.5" android:fillColor="#00000000"
        android:pathData="M54,27a27,27 0,1 1,0 54a27,27 0,1 1,0 -54z" />
    <!-- play mark, optically centred (nudged right) -->
    <path android:fillColor="#FFFFD27A" android:pathData="M47,40.5L67.5,54L47,67.5z" />
</vector>

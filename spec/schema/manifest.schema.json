{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openvideomenu:schema:manifest:0.1",
  "title": "Open Video Menu manifest v0.1 (draft)",
  "description": "Menus over existing media files. Structural rules only; cross-references (menu ids, button ids, media ids, chapter numbers) are checked by the reference validator and described in spec/openvideomenu-v0.1.md. Unknown properties are allowed (readers ignore them); vendor extensions use keys starting with \"x-\".",
  "type": "object",
  "required": [
    "format",
    "version",
    "title",
    "media",
    "fallback"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "openvideomenu"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+$"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "media": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/media"
      }
    },
    "menus": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/menu"
      }
    },
    "rootMenu": {
      "$ref": "#/$defs/id"
    },
    "firstPlay": {
      "$ref": "#/$defs/action"
    },
    "fallback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fallbackGroup"
      }
    },
    "vars": {
      "description": "Level 2: session variables with starting values: an integer or text (a variable keeps that type). Names starting with @ are player state.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[^@]"
      },
      "additionalProperties": {
        "type": [
          "integer",
          "string"
        ]
      }
    }
  },
  "dependentRequired": {
    "menus": [
      "rootMenu"
    ]
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "description": "Relative path (resolved against the manifest's location, forward slashes) or absolute URL.",
      "type": "string",
      "minLength": 1
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "color": {
      "type": "string"
    },
    "title": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer"
        },
        "ids": {
          "type": "object",
          "properties": {
            "imdb": {
              "type": "string"
            },
            "tmdb": {
              "type": "string"
            },
            "tvdb": {
              "type": "string"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string"
        }
      }
    },
    "mediaRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "object",
          "required": [
            "scheme",
            "id"
          ],
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "media": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/mediaRef"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "description": "feature, episode, trailer, featurette, behindthescenes, deleted, interview, scene, short, other (other values allowed).",
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/seconds"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "time"
            ],
            "properties": {
              "time": {
                "$ref": "#/$defs/seconds"
              },
              "label": {
                "type": "string"
              },
              "thumbnail": {
                "$ref": "#/$defs/path"
              }
            }
          }
        },
        "angles": {
          "description": "Level 2: the other angles as files; ref is angle 1, angles[0] angle 2, ... (spec 4.1).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mediaRef"
          }
        },
        "angleTracks": {
          "description": "Level 2: the file's first N video tracks are angles 1..N (spec 4.1).",
          "type": "integer",
          "minimum": 2
        }
      },
      "not": {
        "required": [
          "angles",
          "angleTracks"
        ]
      }
    },
    "rect": {
      "description": "[x, y, width, height] in canvas pixels.",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "aspect": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\s*[0-9]+(\\.[0-9]+)?\\s*([:/]\\s*[0-9]+(\\.[0-9]+)?\\s*)?$"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      }
    },
    "buttonState": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/path"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "textColor": {
          "$ref": "#/$defs/color"
        },
        "fill": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "button": {
      "type": "object",
      "required": [
        "id",
        "rect",
        "action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "label": {
          "type": "string"
        },
        "a11yLabel": {
          "type": "string"
        },
        "showLabel": {
          "type": "boolean"
        },
        "states": {
          "type": "object",
          "properties": {
            "normal": {
              "$ref": "#/$defs/buttonState"
            },
            "selected": {
              "$ref": "#/$defs/buttonState"
            },
            "activated": {
              "$ref": "#/$defs/buttonState"
            }
          }
        },
        "nav": {
          "type": "object",
          "properties": {
            "up": {
              "$ref": "#/$defs/id"
            },
            "down": {
              "$ref": "#/$defs/id"
            },
            "left": {
              "$ref": "#/$defs/id"
            },
            "right": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "autoAction": {
          "type": "boolean"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "if": {
        "properties": {
          "showLabel": {
            "const": true
          }
        },
        "required": [
          "showLabel"
        ]
      },
      "then": {
        "required": [
          "label"
        ]
      }
    },
    "menu": {
      "type": "object",
      "required": [
        "canvas",
        "buttons"
      ],
      "properties": {
        "canvas": {
          "$ref": "#/$defs/canvas"
        },
        "background": {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/$defs/path"
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "video": {
              "$ref": "#/$defs/loopingMedia"
            },
            "audio": {
              "$ref": "#/$defs/loopingMedia"
            }
          }
        },
        "label": {
          "type": "string"
        },
        "defaultButton": {
          "$ref": "#/$defs/buttonRef"
        },
        "autoNav": {
          "type": "boolean"
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "buttonsAt": {
          "$ref": "#/$defs/seconds",
          "description": "Seconds into the intro before buttons appear."
        },
        "back": {
          "$ref": "#/$defs/action",
          "description": "What the remote's Back key does on this menu (any action, incl. activate)."
        },
        "timeout": {
          "type": "object",
          "description": "Level 2: what happens when the menu is left alone. Counted from when the menu appears; a key press restarts it unless restartOnInput is false.",
          "required": [
            "after",
            "action"
          ],
          "properties": {
            "after": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Seconds."
            },
            "action": {
              "$ref": "#/$defs/action"
            },
            "restartOnInput": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "playItem": {
      "type": "object",
      "required": [
        "media"
      ],
      "properties": {
        "media": {
          "$ref": "#/$defs/id"
        },
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "$ref": "#/$defs/seconds"
        },
        "audio": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "object",
              "required": [
                "var"
              ],
              "properties": {
                "var": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ],
          "description": "Level 2: 1-based audio track, or {var}."
        },
        "subtitle": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "object",
              "required": [
                "var"
              ],
              "properties": {
                "var": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ],
          "description": "Level 2: 1-based subtitle track (0 = off), or {var}."
        },
        "angle": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "object",
              "required": [
                "var"
              ],
              "properties": {
                "var": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ],
          "description": "Level 2: 1-based angle of media with angles, or {var} (spec 4.1)."
        }
      }
    },
    "afterAction": {
      "description": "Runs when playback completes. Not a bare play/playAll (use playAll for fixed sequences); an if or do may play, e.g. a disc's conditional play-all.",
      "allOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "goto",
                "back",
                "resume",
                "set",
                "if",
                "do"
              ]
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "play",
            "playAll",
            "goto",
            "back",
            "resume",
            "set",
            "activate",
            "if",
            "do"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "play"
              }
            }
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/playItem"
              }
            ],
            "properties": {
              "after": {
                "$ref": "#/$defs/afterAction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "playAll"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/playItem"
                }
              },
              "after": {
                "$ref": "#/$defs/afterAction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "goto"
              }
            }
          },
          "then": {
            "required": [
              "menu"
            ],
            "properties": {
              "menu": {
                "$ref": "#/$defs/id"
              },
              "button": {
                "$ref": "#/$defs/buttonRef"
              },
              "transition": {
                "$ref": "#/$defs/path",
                "description": "Clip played before the menu opens."
              },
              "history": {
                "enum": [
                  "push",
                  "replace"
                ],
                "description": "Replace = don't add to Back's history (page turns)."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set"
              }
            }
          },
          "then": {
            "required": [
              "var",
              "value"
            ],
            "properties": {
              "var": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/$defs/value"
              },
              "then": {
                "$ref": "#/$defs/action"
              },
              "op": {
                "enum": [
                  "set",
                  "add",
                  "sub",
                  "mul",
                  "div",
                  "mod",
                  "and",
                  "or",
                  "xor",
                  "random"
                ],
                "description": "How the variable changes: replaced (default), arithmetic, bitwise, or a random 1..value."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "activate"
              }
            }
          },
          "then": {
            "required": [
              "button"
            ],
            "properties": {
              "button": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "resume"
              }
            }
          },
          "then": {
            "properties": {
              "otherwise": {
                "description": "Runs instead when there's nothing to resume (the viewer hasn't stopped a title partway). Not another resume.",
                "allOf": [
                  {
                    "$ref": "#/$defs/action"
                  },
                  {
                    "properties": {
                      "type": {
                        "not": {
                          "const": "resume"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "if"
              }
            }
          },
          "then": {
            "required": [
              "test",
              "then"
            ],
            "properties": {
              "test": {
                "$ref": "#/$defs/test"
              },
              "then": {
                "$ref": "#/$defs/action"
              },
              "else": {
                "$ref": "#/$defs/action"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "do"
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ],
            "properties": {
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/action"
                }
              }
            }
          }
        }
      ]
    },
    "fallbackGroup": {
      "type": "object",
      "required": [
        "label",
        "items"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "action"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "allOf": [
                  {
                    "$ref": "#/$defs/action"
                  },
                  {
                    "properties": {
                      "type": {
                        "enum": [
                          "play",
                          "playAll"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "loopingMedia": {
      "description": "Plays once from 0, then loops from loopStart (default 0).",
      "type": "object",
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "$ref": "#/$defs/path"
        },
        "loopStart": {
          "$ref": "#/$defs/seconds"
        }
      }
    },
    "varRef": {
      "type": "object",
      "required": [
        "var"
      ],
      "properties": {
        "var": {
          "type": "string",
          "minLength": 1,
          "description": "A variable of /vars, or @ player state (@audio, @audioLanguage, ...)."
        }
      }
    },
    "value": {
      "description": "An integer, text, or the current value of a variable.",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/varRef"
        }
      ]
    },
    "buttonRef": {
      "description": "A button id, or a variable holding one.",
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "$ref": "#/$defs/varRef"
        }
      ]
    },
    "test": {
      "description": "Level 2: a condition: one comparison of a variable (eq/ne any value; lt/le/gt/ge integers; has = any bit set), or all/any/not.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "var"
          ],
          "properties": {
            "var": {
              "type": "string",
              "minLength": 1
            },
            "eq": {
              "$ref": "#/$defs/value"
            },
            "ne": {
              "$ref": "#/$defs/value"
            },
            "lt": {
              "$ref": "#/$defs/value"
            },
            "le": {
              "$ref": "#/$defs/value"
            },
            "gt": {
              "$ref": "#/$defs/value"
            },
            "ge": {
              "$ref": "#/$defs/value"
            },
            "has": {
              "$ref": "#/$defs/value"
            }
          },
          "minProperties": 2,
          "maxProperties": 2
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/test"
              }
            }
          },
          "maxProperties": 1
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/test"
              }
            }
          },
          "maxProperties": 1
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/test"
            }
          },
          "maxProperties": 1
        }
      ]
    }
  }
}

{
  "description": "Level 1: with autoNav, missing directions move to the nearest button that way; explicit nav still wins; no button that way means no move.",
  "level": 1,
  "valid": true,
  "manifest": {
    "format": "openvideomenu",
    "version": "0.1",
    "title": { "name": "Grid" },
    "media": { "a": { "ref": "a.mp4" } },
    "menus": {
      "grid": {
        "canvas": { "width": 1000, "height": 1000 },
        "autoNav": true,
        "buttons": [
          { "id": "tl", "rect": [100, 100, 200, 100], "action": { "type": "play", "media": "a" } },
          { "id": "tr", "rect": [600, 100, 200, 100], "action": { "type": "play", "media": "a" } },
          { "id": "bl", "rect": [100, 600, 200, 100], "nav": { "right": "tl" }, "action": { "type": "play", "media": "a" } },
          { "id": "br", "rect": [600, 600, 200, 100], "action": { "type": "play", "media": "a" } }
        ]
      }
    },
    "rootMenu": "grid",
    "fallback": [{ "label": "Movie", "items": [{ "label": "A", "action": { "type": "play", "media": "a" } }] }]
  },
  "steps": [
    { "event": { "type": "start" }, "expect": { "focus": "tl" } },
    { "event": { "type": "press", "key": "right" }, "expect": { "focus": "tr" } },
    { "event": { "type": "press", "key": "down" }, "expect": { "focus": "br" } },
    { "event": { "type": "press", "key": "left" }, "expect": { "focus": "bl" } },
    { "event": { "type": "press", "key": "left" }, "expect": { "focus": "bl" } },
    { "event": { "type": "press", "key": "right" }, "expect": { "focus": "tl" } }
  ]
}

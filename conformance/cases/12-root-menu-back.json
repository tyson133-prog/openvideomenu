{
  "description": "Remote Back on the root menu leaves the title, however the viewer got there. Walk: main → languages → a button that returns to main (a goto, so it adds history); Back on main exits rather than retracing to languages. Other menus still return through history.",
  "level": 1,
  "valid": true,
  "manifest": {
    "format": "openvideomenu",
    "version": "0.1",
    "title": { "name": "Root menu back" },
    "media": { "feature": { "ref": "Film.mp4" } },
    "menus": {
      "main": {
        "canvas": { "width": 720, "height": 480 },
        "buttons": [
          { "id": "play", "rect": [100, 100, 200, 40], "nav": { "down": "languages" }, "action": { "type": "play", "media": "feature" } },
          { "id": "languages", "rect": [100, 160, 200, 40], "nav": { "up": "play" }, "action": { "type": "goto", "menu": "languages" } }
        ]
      },
      "languages": {
        "canvas": { "width": 720, "height": 480 },
        "buttons": [
          { "id": "subs-on", "rect": [100, 100, 200, 40], "action": { "type": "goto", "menu": "main", "button": "play" } }
        ]
      }
    },
    "rootMenu": "main",
    "fallback": [{ "label": "Movie", "items": [{ "label": "Play", "action": { "type": "play", "media": "feature" } }] }]
  },
  "steps": [
    { "event": { "type": "start" }, "expect": { "mode": "menu", "menu": "main", "focus": "play" } },
    { "event": { "type": "press", "key": "down" }, "expect": { "focus": "languages" } },
    { "event": { "type": "press", "key": "enter" }, "expect": { "menu": "languages", "focus": "subs-on" } },
    { "event": { "type": "press", "key": "back" }, "expect": { "menu": "main", "focus": "languages", "effects": [] } },
    { "event": { "type": "press", "key": "enter" }, "expect": { "menu": "languages", "focus": "subs-on" } },
    { "event": { "type": "press", "key": "enter" }, "expect": { "menu": "main", "focus": "play" } },
    { "event": { "type": "press", "key": "back" }, "expect": { "menu": "main", "effects": [{ "type": "exit" }] } }
  ]
}

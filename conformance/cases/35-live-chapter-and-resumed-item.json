      "film": {
        "ref": "Film.mkv",
        "number": 7,
        "chapters": [
          {
            "time": 0
          },
          {
            "time": 100
          },
          {
            "time": 200
          },
          {
            "time": 300
          }
        ],
        "cues": [
          {
            "at": 200,
            "action": {
              "type": "if",
              "test": {
                "var": "@lastChapter",
                "eq": 2
              },
              "then": {
                "type": "goto",
                "menu": "ch2"
              },
              "else": {
                "type": "goto",
                "menu": "other"
              }
            }
          }
        ],
        "keys": {
          "menu": {
            "type": "if",
            "test": {
              "var": "@lastChapter",
              "eq": 4
            },
            "then": {
              "type": "goto",
              "menu": "ch3"
            },
            "else": {
              "type": "goto",
              "menu": "other"
            }
          }
        }
      }
    },
    "actions": {

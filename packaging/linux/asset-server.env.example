# /etc/openvideomenu/asset-server.env: settings for openvideomenu-asset-server.service
# (the same names as the Docker image; see packages/asset-server/README.md for all options).

# Media folders to scan for .openvideomenu.json manifests, comma-separated.
MEDIA_ROOTS=/mnt/media/movies,/mnt/media/tv

# Your media server; sign-ins from the TV apps are checked against it. Give either or both.
PLEX_URL=http://127.0.0.1:32400
#JELLYFIN_URL=http://127.0.0.1:8096

# Name shown in the TV apps.
SERVER_NAME=Open Video Menu

#PORT=8790

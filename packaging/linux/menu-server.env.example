# /etc/openvideomenu/menu-server.env: settings for openvideomenu-menu-server.service (install.sh writes it).
# Keep it readable by root only (chmod 600): it holds your Plex token or Jellyfin API key.

# Your media server, and its token. With it, the menu server reads the library folders from the
# media server and follows them when you add a library. TV apps' sign-ins are checked against it.
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
#JELLYFIN_URL=http://127.0.0.1:8096
#JELLYFIN_API_KEY=

# When the media server sees the folders under other paths than this machine (Plex in a container
# sees /data, here it's /mnt/media): from=to, ";" between.
#PATH_MAP=/data=/mnt/media

# Extra folders to scan besides the libraries, comma-separated (optional).
#MEDIA_ROOTS=

# Name shown in the TV apps.
#SERVER_NAME=Open Video Menu

#PORT=8790
